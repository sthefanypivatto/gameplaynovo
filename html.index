<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Free Fire 2.0 Classic 2019</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;background:#101720;color:white;
 font-family:Arial,sans-serif;
}
header{
 background:#192431;padding:15px;
 display:flex;justify-content:space-between;
 align-items:center;flex-wrap:wrap;
 border-bottom:3px solid #ff9800;
}
.logo{color:#ff9800;font-size:23px;font-weight:bold}
.money{color:#ffd34d;font-weight:bold}
nav{
 display:flex;flex-wrap:wrap;gap:5px;
 justify-content:center;background:#263443;padding:10px;
}
button{
 border:0;border-radius:6px;padding:11px;
 font-weight:bold;cursor:pointer;
}
nav button{background:#405368;color:white}
button:active{transform:scale(.96)}
.primary{background:#ff9800;color:#111}
.dark{background:#405368;color:white}
.page{display:none;padding:18px;max-width:1100px;margin:auto}
.page.active{display:block}
.card{
 background:#202e3c;padding:17px;
 margin:12px 0;border-radius:10px;
 border:1px solid #405368;
}
h1,h2{color:#ffad32}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
 gap:12px;
}
.item{
 background:#293b4c;padding:14px;
 border-radius:9px;text-align:center;
}
.item button{width:100%;margin-top:8px}
.character{font-size:60px}
.small{font-size:12px;color:#b7c4d0}
.center{text-align:center}
#gameCanvas{
 width:100%;height:auto;display:block;
 background:#627e48;border:3px solid #ff9800;
 border-radius:8px;touch-action:none;
}
.stats{
 display:flex;justify-content:space-around;
 flex-wrap:wrap;background:#263443;
 padding:12px;gap:10px;
}
.controls{
 display:grid;grid-template-columns:repeat(3,65px);
 justify-content:center;gap:7px;margin:15px;
}
.controls button{
 background:#ff9800;font-size:22px;
 height:55px;
}
#gameMessage{text-align:center;color:#ffcf50}
input,select{
 padding:10px;border-radius:5px;
 max-width:100%;
}
.bar{
 background:#444;height:10px;border-radius:10px;
 overflow:hidden;
}
.bar div{background:#39d353;height:100%}
</style>
</head>

<body>

<header>
 <div class="logo">🔥 FREE FIRE 2.0</div>
 <div class="money">
 💎 <span id="diamonds">1000</span>
 &nbsp; 🪙 <span id="coins">5000</span>
 </div>
</header>

<nav>
 <button onclick="page('lobby')">LOBBY</button>
 <button onclick="page('characters')">PERSONAGENS</button>
 <button onclick="page('store')">LOJA</button>
 <button onclick="page('inventory')">COFRE</button>
 <button onclick="page('missions')">MISSÕES</button>
 <button onclick="page('profile')">PERFIL</button>
 <button onclick="page('settings')">AJUSTES</button>
</nav>

<!-- LOBBY -->

<section id="lobby" class="page active">
 <div class="card center">
  <h1>FREE FIRE 2.0</h1>
  <h2>CLASSIC 2019</h2>
  <div class="character" id="lobbyEmoji">🧑</div>
  <h2 id="lobbyName">Adam</h2>
  <p>Prepare-se para entrar na batalha!</p>
  <button class="primary" onclick="startGame()">🔥 JOGAR AGORA</button>
 </div>

 <div class="grid">
  <div class="card">
   <h3>🏆 MODO</h3>
   <p>Battle Royale</p>
  </div>
  <div class="card">
   <h3>🎯 OBJETIVO</h3>
   <p>Elimine os inimigos e sobreviva.</p>
  </div>
  <div class="card">
   <h3>🎁 RECOMPENSAS</h3>
   <p>Ganhe moedas e experiência.</p>
  </div>
 </div>
</section>

<!-- PERSONAGENS -->

<section id="characters" class="page">
 <h1>PERSONAGENS</h1>
 <div class="grid" id="characterList"></div>
</section>

<!-- LOJA -->

<section id="store" class="page">
 <h1>LOJA</h1>

 <div class="card">
  <h2>💎 DIAMANTES</h2>
  <p class="small">Moeda de demonstração do jogo.</p>
  <div class="grid" id="diamondList"></div>
 </div>

 <h2>👕 ROUPAS E SKINS</h2>
 <div class="grid" id="skinList"></div>

 <h2>🔫 ARMAS</h2>
 <div class="grid" id="weaponList"></div>
</section>

<!-- COFRE -->

<section id="inventory" class="page">
 <h1>MEU COFRE</h1>
 <div class="card">
  <h2>Personagem</h2>
  <p id="invCharacter"></p>
  <h2>Arma equipada</h2>
  <p id="invWeapon"></p>
 </div>
 <div class="card">
  <h2>Itens adquiridos</h2>
  <div id="invItems"></div>
 </div>
</section>

<!-- MISSÕES -->

<section id="missions" class="page">
 <h1>MISSÕES</h1>

 <div class="card">
  <h3>☠️ Elimine 3 inimigos</h3>
  <p id="mission1"></p>
  <div class="bar"><div id="bar1"></div></div>
  <button class="primary" onclick="claim(0)">RESGATAR</button>
 </div>

 <div class="card">
  <h3>🎮 Jogue uma partida</h3>
  <p id="mission2"></p>
  <div class="bar"><div id="bar2"></div></div>
  <button class="primary" onclick="claim(1)">RESGATAR</button>
 </div>

 <div class="card">
  <h3>🏆 Consiga uma vitória</h3>
  <p id="mission3"></p>
  <div class="bar"><div id="bar3"></div></div>
  <button class="primary" onclick="claim(2)">RESGATAR</button>
 </div>
</section>

<!-- PERFIL -->

<section id="profile" class="page">
 <h1>PERFIL</h1>
 <div class="card center">
  <div class="character">👤</div>
  <h2 id="profileName">Jogador</h2>
  <p>Nível: <span id="level">1</span></p>
  <p>XP: <span id="xp">0</span></p>
  <p>Partidas: <span id="games">0</span></p>
  <p>Eliminações: <span id="kills">0</span></p>
  <p>Vitórias: <span id="wins">0</span></p>
  <button class="dark" onclick="changeName()">ALTERAR NOME</button>
 </div>
</section>

<!-- AJUSTES -->

<section id="settings" class="page">
 <h1>CONFIGURAÇÕES</h1>

 <div class="card">
  <h3>🔊 Volume</h3>
  <input type="range" min="0" max="100" value="70">
 </div>

 <div class="card">
  <h3>🎮 Gráficos</h3>
  <select>
   <option>Baixo</option>
   <option selected>Médio</option>
   <option>Alto</option>
  </select>
 </div>

 <div class="card">
  <h3>Controles</h3>
  <p>WASD ou setas: movimentar.</p>
  <p>Espaço: atirar.</p>
  <p>Botão de tiro: atirar no inimigo mais próximo.</p>
 </div>
</section>

<!-- JOGO -->

<section id="game" class="page">
 <h1>🔥 BATTLE ROYALE</h1>

 <div class="stats">
  <span>❤️ <b id="health">100</b></span>
  <span>🔫 <b id="ammo">30</b></span>
  <span>☠️ <b id="gameKills">0</b></span>
  <span>👥 <b id="enemyCount">8</b></span>
 </div>

 <canvas id="gameCanvas" width="900" height="550"></canvas>

 <div class="controls">
  <span></span>
  <button onpointerdown="holdMove(0,-1)" onpointerup="stopMove()" onpointerleave="stopMove()">⬆️</button>
  <span></span>
  <button onpointerdown="holdMove(-1,0)" onpointerup="stopMove()" onpointerleave="stopMove()">⬅️</button>
  <button onclick="reload()">🔄</button>
  <button onpointerdown="holdMove(1,0)" onpointerup="stopMove()" onpointerleave="stopMove()">➡️</button>
  <span></span>
  <button onpointerdown="holdMove(0,1)" onpointerup="stopMove()" onpointerleave="stopMove()">⬇️</button>
  <span></span>
 </div>

 <div class="center">
  <button class="primary" onclick="shoot()">🔫 ATIRAR</button>
  <button class="dark" onclick="reload()">RECARREGAR</button>
  <button class="dark" onclick="leaveGame()">SAIR</button>
 </div>

 <p id="gameMessage">Elimine todos os inimigos!</p>
</section>

<script>

// =================================
// SALVAMENTO
// =================================

const defaultData={
 diamonds:1000,
 coins:5000,
 name:"Jogador",
 character:"Adam",
 weapon:"MP40",
 inventory:[],
 skins:[],
 kills:0,
 games:0,
 wins:0,
 xp:0,
 claimed:[],
 redeemed:[]
};

let data;

try{
 data=JSON.parse(localStorage.getItem("ff2save"))||defaultData;
}catch(e){
 data=defaultData;
}

data={...defaultData,...data};

function save(){
 localStorage.setItem("ff2save",JSON.stringify(data));
 update();
}

function page(id){
 document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
 document.getElementById(id).classList.add("active");
 update();
}

function update(){
 document.getElementById("diamonds").textContent=data.diamonds;
 document.getElementById("coins").textContent=data.coins;

 document.getElementById("lobbyName").textContent=data.character;
 document.getElementById("lobbyEmoji").textContent=
 characters.find(c=>c.name===data.character)?.emoji||"🧑";

 document.getElementById("profileName").textContent=data.name;
 document.getElementById("level").textContent=Math.floor(data.xp/100)+1;
 document.getElementById("xp").textContent=data.xp;
 document.getElementById("games").textContent=data.games;
 document.getElementById("kills").textContent=data.kills;
 document.getElementById("wins").textContent=data.wins;

 document.getElementById("invCharacter").textContent=data.character;
 document.getElementById("invWeapon").textContent=data.weapon;
 document.getElementById("invItems").textContent=
 data.inventory.join(", ")||"Nenhum item adquirido.";

 missionUI();
}

function changeName(){
 let name=prompt("Digite seu nome:");
 if(name&&name.trim()){
  data.name=name.trim().slice(0,20);
  save();
 }
}

// =================================
// PERSONAGENS
// =================================

const characters=[
 {name:"Adam",emoji:"🧑",price:0},
 {name:"Eve",emoji:"👩",price:200},
 {name:"Kelly",emoji:"🏃‍♀️",price:300},
 {name:"Andrew",emoji:"👮",price:350},
 {name:"Maxim",emoji:"🧔",price:400},
 {name:"Moco",emoji:"👩‍💻",price:500}
];

function renderCharacters(){
 const el=document.getElementById("characterList");
 el.innerHTML="";

 characters.forEach(c=>{
  let owned=c.price===0||data.inventory.includes(c.name);

  el.innerHTML+=`
  <div class="item">
   <div class="character">${c.emoji}</div>
   <h3>${c.name}</h3>
   <p>${c.price===0?"Grátis":c.price+" 💎"}</p>
   <button class="primary" onclick="selectCharacter('${c.name}')">
   ${data.character===c.name?"EQUIPADO":owned?"EQUIPAR":"COMPRAR"}
   </button>
  </div>`;
 });
}

function selectCharacter(name){
 let c=characters.find(x=>x.name===name);
 if(!c)return;

 if(c.price>0&&!data.inventory.includes(name)){
  if(data.diamonds<c.price){
   alert("Diamantes insuficientes!");
   return;
  }
  data.diamonds-=c.price;
  data.inventory.push(name);
 }

 data.character=name;
 save();
 renderCharacters();
}

// =================================
// DIAMANTES
// =================================

function renderDiamonds(){
 let packs=[
  {amount:100},
  {amount:500},
  {amount:1000},
  {amount:2500}
 ];

 document.getElementById("diamondList").innerHTML=packs.map(p=>`
 <div class="item">
  <h2>💎 ${p.amount}</h2>
  <p>Pacote de demonstração</p>
  <button class="primary" onclick="getDiamonds(${p.amount})">RESGATAR</button>
 </div>
 `).join("");
}

function getDiamonds(amount){
 if(data.redeemed.includes(amount)){
  alert("Esse pacote já foi resgatado!");
  return;
 }

 data.diamonds+=amount;
 data.redeemed.push(amount);
 save();
 alert("Diamantes adicionados!");
}

// =================================
// SKINS
// =================================

const skins=[
 {name:"Uniforme clássico",emoji:"👕",price:100},
 {name:"Roupa urbana",emoji:"🧥",price:200},
 {name:"Conjunto militar",emoji:"🥷",price:350},
 {name:"Conjunto lendário",emoji:"👑",price:500}
];

function renderSkins(){
 document.getElementById("skinList").innerHTML=skins.map(s=>{
 let owned=data.skins.includes(s.name);

 return `
 <div class="item">
  <div class="character">${s.emoji}</div>
  <h3>${s.name}</h3>
  <p>${s.price} 💎</p>
  <button class="primary" onclick="buySkin('${s.name}')">
  ${owned?"ADQUIRIDA":"COMPRAR"}
  </button>
 </div>`;
 }).join("");
}

function buySkin(name){
 let s=skins.find(x=>x.name===name);
 if(!s||data.skins.includes(name))return;

 if(data.diamonds<s.price){
  alert("Diamantes insuficientes!");
  return;
 }

 data.diamonds-=s.price;
 data.skins.push(name);
 data.inventory.push(name);
 save();
 renderSkins();
 alert("Skin comprada!");
}

// =================================
// ARMAS
// =================================

const weapons=[
 {name:"MP40",price:0,emoji:"🔫"},
 {name:"AK47",price:200,emoji:"🔫"},
 {name:"M4A1",price:250,emoji:"🔫"},
 {name:"AWM",price:400,emoji:"🎯"},
 {name:"M1014",price:300,emoji:"🔫"},
 {name:"UMP",price:150,emoji:"🔫"}
];

function renderWeapons(){
 document.getElementById("weaponList").innerHTML=weapons.map(w=>{
 let owned=w.price===0||data.inventory.includes(w.name);

 return `
 <div class="item">
  <div class="character">${w.emoji}</div>
  <h3>${w.name}</h3>
  <p>${w.price===0?"Grátis":w.price+" 💎"}</p>
  <button class="primary" onclick="buyWeapon('${w.name}')">
  ${data.weapon===w.name?"EQUIPADA":owned?"EQUIPAR":"COMPRAR"}
  </button>
 </div>`;
 }).join("");
}

function buyWeapon(name){
 let w=weapons.find(x=>x.name===name);
 if(!w)return;

 if(!data.inventory.includes(name)){
  if(data.diamonds<w.price){
   alert("Diamantes insuficientes!");
   return;
  }
  data.diamonds-=w.price;
  data.inventory.push(name);
 }

 data.weapon=name;
 save();
 renderWeapons();
}

// =================================
// MISSÕES
// =================================

function missionUI(){
 const progress=[
  Math.min(data.kills,3),
  Math.min(data.games,1),
  Math.min(data.wins,1)
 ];

 const goals=[3,1,1];

 for(let i=0;i<3;i++){
  document.getElementById("mission"+(i+1)).textContent=
  "Progresso: "+progress[i]+"/"+goals[i];

  document.getElementById("bar"+(i+1)).style.width=
  (progress[i]/goals[i]*100)+"%";
 }
}

function claim(id){
 if(data.claimed.includes(id)){
  alert("Recompensa já recebida!");
  return;
 }

 let complete=[
  data.kills>=3,
  data.games>=1,
  data.wins>=1
 ];

 if(!complete[id]){
  alert("Missão ainda não concluída!");
  return;
 }

 data.claimed.push(id);
 data.coins+=500;
 data.xp+=100;
 save();
 alert("Você ganhou 500 moedas e 100 XP!");
}

// =================================
// MOTOR DA PARTIDA
// =================================

const canvas=document.getElementById("gameCanvas");
const ctx=canvas.getContext("2d");

let player;
let enemies=[];
let bullets=[];
let running=false;
let kills=0;
let gameTimer=null;
let zone=260;
let keys={};
let movement={x:0,y:0};
let lastShot=0;
let lastDamage=0;
let ammo=30;
let reloading=false;

function startGame(){
 if(gameTimer)clearInterval(gameTimer);

 page("game");

 player={x:450,y:275,hp:100};

 enemies=[];
 bullets=[];
 kills=0;
 zone=260;
 ammo=30;
 reloading=false;
 lastDamage=0;

 for(let i=0;i<8;i++){
  let x,y;

  do{
   x=40+Math.random()*820;
   y=40+Math.random()*470;
  }while(Math.hypot(x-450,y-275)<120);

  enemies.push({
   x,y,hp:100,speed:0.6+Math.random()*0.4,
   lastAttack:0
  });
 }

 running=true;

 document.getElementById("gameMessage").textContent=
 "Elimine os inimigos e sobreviva!";

 gameTimer=setInterval(updateGame,30);
 drawGame();
}

function updateGame(){
 if(!running)return;

 let speed=3.8;

 let mx=0,my=0;

 if(keys["w"]||keys["arrowup"])my--;
 if(keys["s"]||keys["arrowdown"])my++;
 if(keys["a"]||keys["arrowleft"])mx--;
 if(keys["d"]||keys["arrowright"])mx++;

 mx+=movement.x;
 my+=movement.y;

 if(mx||my){
  let len=Math.hypot(mx,my);
  player.x+=mx/len*speed;
  player.y+=my/len*speed;
 }

 player.x=Math.max(15,Math.min(885,player.x));
 player.y=Math.max(15,Math.min(535,player.y));

 let now=Date.now();

 enemies.forEach(e=>{
  let dx=player.x-e.x;
  let dy=player.y-e.y;
  let dist=Math.hypot(dx,dy);

  if(dist>22){
   e.x+=dx/dist*e.speed;
   e.y+=dy/dist*e.speed;
  }

  if(dist<30&&now-e.lastAttack>900){
   player.hp-=6;
   e.lastAttack=now;
  }
 });

 bullets.forEach(b=>{
  b.x+=b.vx;
  b.y+=b.vy;

  enemies.forEach(e=>{
   if(e.hp>0&&Math.hypot(b.x-e.x,b.y-e.y)<19){
    e.hp-=b.damage;
    b.dead=true;

    if(e.hp<=0){
     kills++;
     data.kills++;
     data.xp+=20;
    }
   }
  });
 });

 bullets=bullets.filter(b=>
  !b.dead&&b.x>0&&b.x<900&&b.y>0&&b.y<550
 );

 enemies=enemies.filter(e=>e.hp>0);

 if(zone>80)zone-=0.018;

 if(Math.hypot(player.x-450,player.y-275)>zone){
  if(now-lastDamage>500){
   player.hp-=3;
   lastDamage=now;
  }
 }

 if(player.hp<=0){
  endGame(false);
  return;
 }

 if(enemies.length===0){
  endGame(true);
  return;
 }

 drawGame();
}

function drawGame(){
 if(!player)return;

 ctx.clearRect(0,0,900,550);

 // TERRENO
 ctx.fillStyle="#718a50";
 ctx.fillRect(0,0,900,550);

 // CAMINHOS
 ctx.fillStyle="#b3a17b";
 ctx.fillRect(0,120,900,45);
 ctx.fillRect(250,0,50,550);
 ctx.fillRect(650,0,35,550);

 // ÁRVORES
 for(let i=0;i<24;i++){
  let x=(i*137+40)%900;
  let y=(i*83+35)%550;

  ctx.fillStyle="#294b2c";
  ctx.beginPath();
  ctx.arc(x,y,16,0,Math.PI*2);
  ctx.fill();
 }

 // CASAS
 ctx.fillStyle="#9b6541";
 ctx.fillRect(90,200,75,65);
 ctx.fillRect(710,320,90,75);
 ctx.fillStyle="#49382d";
 ctx.fillRect(105,215,20,25);
 ctx.fillRect(730,335,25,25);

 // ZONA
 ctx.strokeStyle="#45c9ff";
 ctx.lineWidth=4;
 ctx.beginPath();
 ctx.arc(450,275,zone,0,Math.PI*2);
 ctx.stroke();

 // TIROS
 bullets.forEach(b=>{
  ctx.fillStyle="#ffed67";
  ctx.beginPath();
  ctx.arc(b.x,b.y,5,0,Math.PI*2);
  ctx.fill();
 });

 // INIMIGOS
 enemies.forEach(e=>{
  ctx.fillStyle="#c82d2d";
  ctx.fillRect(e.x-10,e.y-10,20,20);

  ctx.fillStyle="black";
  ctx.fillRect(e.x-13,e.y-20,26,4);

  ctx.fillStyle="#44ed55";
  ctx.fillRect(e.x-13,e.y-20,26*(e.hp/100),4);
 });

 // JOGADOR
 ctx.fillStyle="#258cff";
 ctx.beginPath();
 ctx.arc(player.x,player.y,13,0,Math.PI*2);
 ctx.fill();

 ctx.strokeStyle="white";
 ctx.lineWidth=2;
 ctx.stroke();

 document.getElementById("health").textContent=
 Math.max(0,Math.ceil(player.hp));

 document.getElementById("ammo").textContent=ammo;
 document.getElementById("gameKills").textContent=kills;
 document.getElementById("enemyCount").textContent=enemies.length;
}

// =================================
// TIROS
// =================================

function shoot(){
 if(!running||ammo<=0||reloading)return;

 let now=Date.now();
 if(now-lastShot<350)return;
 lastShot=now;

 let target=null;
 let best=Infinity;

 enemies.forEach(e=>{
  let d=Math.hypot(e.x-player.x,e.y-player.y);
  if(d<best){
   best=d;
   target=e;
  }
 });

 if(!target)return;

 let dx=target.x-player.x;
 let dy=target.y-player.y;
 let dist=Math.hypot(dx,dy);

 bullets.push({
  x:player.x,
  y:player.y,
  vx:dx/dist*13,
  vy:dy/dist*13,
  damage:50
 });

 ammo--;
 drawGame();
}

function reload(){
 if(!running||reloading||ammo===30)return;

 reloading=true;

 document.getElementById("gameMessage").textContent=
 "Recarregando...";

 setTimeout(()=>{
  if(!running)return;
  ammo=30;
  reloading=false;
  document.getElementById("gameMessage").textContent=
  "Munição recarregada!";
  drawGame();
 },1200);
}

// =================================
// CONTROLES MOBILE
// =================================

function holdMove(x,y){
 movement={x,y};
}

function stopMove(){
 movement={x:0,y:0};
}

document.addEventListener("keydown",e=>{
 keys[e.key.toLowerCase()]=true;

 if(e.code==="Space"){
  e.preventDefault();
  shoot();
 }
});

document.addEventListener("keyup",e=>{
 keys[e.key.toLowerCase()]=false;
});

// =================================
// FINAL DA PARTIDA
// =================================

function endGame(win){
 if(!running)return;

 running=false;
 clearInterval(gameTimer);
 gameTimer=null;

 data.games++;

 if(win){
  data.wins++;
  data.coins+=1000;
  data.xp+=100;

  document.getElementById("gameMessage").textContent=
  "🏆 BOOYAH! Você venceu! +1000 moedas!";
 }else{
  data.coins+=100;
  document.getElementById("gameMessage").textContent=
  "Você foi eliminado! +100 moedas.";
 }

 save();

 ctx.fillStyle="rgba(0,0,0,.75)";
 ctx.fillRect(0,0,900,550);

 ctx.fillStyle="white";
 ctx.textAlign="center";
 ctx.font="bold 38px Arial";
 ctx.fillText(win?"BOOYAH!":"ELIMINADO",450,240);

 ctx.font="22px Arial";
 ctx.fillText("Eliminações: "+kills,450,290);
 ctx.fillText("Partida finalizada",450,330);

 ctx.textAlign="left";
}

function leaveGame(){
 if(running){
  running=false;
  clearInterval(gameTimer);
  gameTimer=null;
 }

 page("lobby");
}

// =================================
// INICIALIZAÇÃO
// =================================

renderCharacters();
renderDiamonds();
renderSkins();
renderWeapons();
update();

</script>

</body>
</html>
